PORT=4000

# Generate a strong random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated list of allowed frontend origins (no trailing slash), e.g.:
#   https://globalneststudy.vercel.app,https://www.globalneststudysolution.com
CLIENT_ORIGIN=http://localhost:5173

# --- Database (Turso / libSQL) ---
# Leave both unset for local dev — falls back to a local SQLite file at
# server/data/globalnest.db. Set both in production so the database survives
# redeploys/restarts on hosts with no persistent disk (e.g. Render free tier).
# Get these from your database's page on turso.tech.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# --- File storage (Cloudinary) ---
# Required in any environment where uploads need to work (admin image
# uploads, the optional inquiry-form document upload) — there's no local-file
# fallback for these, since local disk isn't guaranteed to persist. Get these
# from your Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
